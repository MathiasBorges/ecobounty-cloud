# ==============================================================================
# EcoBounty — Variáveis de Ambiente (Template de Configuração Cloud)
# Copie este arquivo para `.env` e preencha com suas credenciais locais/nuvem.
# NUNCA faça commit do arquivo `.env` real no controle de versão (R6).
# ==============================================================================

# Servidor Web / Proxy Reverso
ECOBOUNTY_HOST=0.0.0.0
ECOBOUNTY_PORT=8550
ECOBOUNTY_SIMULATION_MODE=true

# Backends de Armazenamento e Visão Computacional ("catbox" | "firebase" | "local" / "gemini" | "local")
ECOBOUNTY_STORAGE_BACKEND=catbox
ECOBOUNTY_VISION_BACKEND=gemini

# Google Cloud Platform & Firebase (Projeto ecobounty-9d250)
GCP_PROJECT_ID=ecobounty-9d250
FIREBASE_STORAGE_BUCKET=ecobounty-9d250.firebasestorage.app
FIREBASE_AUTH_DOMAIN=ecobounty-9d250.firebaseapp.com
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Google Gemini Multimodal API (Google AI Studio Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Catbox CDN Storage
CATBOX_USERHASH=

# Google Maps / Geocoding (Opcional — fallback nativo para OpenStreetMap / OSRM gratuito)
GOOGLE_MAPS_API_KEY=
